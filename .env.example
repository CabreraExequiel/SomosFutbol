# Completá este archivo en una copia llamada .env. No lo compartas.
DOMAIN=futbol.tu-dominio.com
PUBLIC_URL=https://futbol.tu-dominio.com
SPRING_PROFILES_ACTIVE=prod
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=43200000
# Identidad y contacto del operador: aparecen en Términos y Privacidad.
LEGAL_OPERATOR=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
SUPPORT_EMAIL=
TERMS_VERSION=2026-10-09
PRIVACY_VERSION=2026-10-09
# Primera puesta en marcha: transferencias directas al dueño.
PAYMENTS_ENABLED=false
MERCADOPAGO_TEST_MODE=true
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
MP_ENCRYPTION_KEY=
